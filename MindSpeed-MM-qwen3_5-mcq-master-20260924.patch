+"""No model loading: fake adapters exercise timing and rank ownership."""
+
+import os
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import torch
+
+os.environ.setdefault("NON_MEGATRON", "true")
+
+from mindspeed_mm.fsdp.inference import infer_engine
+
+
+class FakeAdapter:
+    def __init__(self, events):
+        self.events = events
+        self.generated = []
+        self.decoded = []
+
+    def preprocess(self, messages):
+        self.current = messages[0]["index"]
+        return {"input_ids": torch.ones((1, 2), dtype=torch.long)}
+
+    def generate(self, inputs, generation):
+        self.events.append("generate")
+        self.generated.append(self.current)
+        return torch.ones((1, 4 + self.current), dtype=torch.long)
+
+    def decode(self, inputs, outputs):
+        self.decoded.append(self.current)
+        return "B"
+
+
+def make_engine(monkeypatch, rank=0, world_size=2, count=2, replicated=True):
+    events = []
+    monkeypatch.setattr(infer_engine.dist, "get_rank", lambda: rank)
+    monkeypatch.setattr(infer_engine.dist, "get_world_size", lambda: world_size)
+    monkeypatch.setattr(infer_engine, "synchronize", lambda: events.append("sync"))
+    # Total start; two generate intervals of 1 s and 3 s; total finish.
+    times = iter([0.0, 10.0, 11.0, 20.0, 23.0, 30.0] if count else [0.0, 0.0])
+
+    def clock():
+        events.append("clock")
+        return next(times)
+
+    monkeypatch.setattr(infer_engine.time, "perf_counter", clock)
+    messages = []
+    monkeypatch.setattr(infer_engine, "print_rank", lambda function, value: messages.append(value))
+    adapter = FakeAdapter(events)
+    engine = infer_engine.InferEngine(
+        SimpleNamespace(inference=SimpleNamespace(generation=object())),
+        adapter,
+        [{"text": f"sample {index}"} for index in range(count)],
+        count,
+        replicated_inputs=replicated,
+    )
+    return engine, adapter, events, messages
+
+
+def sample_builder(item, index):
+    return [{"index": index}]
+
+
+def test_replicated_rank_zero_and_weighted_throughput(monkeypatch):
+    engine, adapter, events, messages = make_engine(monkeypatch)
+    gather = Mock(side_effect=AssertionError("Replicated inputs must not gather duplicate predictions"))
+    monkeypatch.setattr(engine, "gather_batch_results", gather)
+    results = engine.infer(sample_builder)
+    assert len(results) == 2
+    assert adapter.generated == adapter.decoded == [0, 1]
+    assert [result["global_index"] for _, result in results] == [0, 1]
+    assert [result["inference_duration"] for _, result in results] == [1.0, 3.0]
+    assert events == [
+        "clock",
+        "sync",
+        "clock",
+        "generate",
+        "sync",
+        "clock",
+        "sync",
+        "clock",
+        "generate",
+        "sync",
+        "clock",
+        "clock",
+    ]
+    assert "Total generate duration: 4.0000 seconds" in messages
+    # (2 + 3) / (1 + 3) = 1.25, not mean(2/1, 3/3) = 1.5 or x world_size.
+    assert "Decode throughput: 1.25 tokens/second" in messages
+    gather.assert_not_called()
+
+
+def test_replicated_other_rank_still_generates_every_sample(monkeypatch):
+    engine, adapter, _, _ = make_engine(monkeypatch, rank=1)
+    assert engine.infer(sample_builder) == []
+    assert adapter.generated == [0, 1]
+    assert adapter.decoded == []
+
+
+def test_empty_input_has_zero_throughput(monkeypatch):
+    engine, adapter, _, messages = make_engine(monkeypatch, count=0)
+    assert engine.infer(sample_builder) == []
+    assert adapter.generated == []
+    assert "Decode throughput: 0.00 tokens/second" in messages
+
+
+def test_existing_partitioned_path_still_gathers(monkeypatch):
+    engine, adapter, _, _ = make_engine(monkeypatch, rank=1, replicated=False)
+    gather = Mock(return_value=[])
+    monkeypatch.setattr(engine, "gather_batch_results", gather)
+    engine.infer(sample_builder)
+    assert adapter.generated == [1, 0]  # Second local item is sampler padding.
+    assert gather.call_count == 2
+    assert gather.call_args_list[0].args[0][1]["global_index"] == 1
+    assert gather.call_args_list[1].args == (None,)
+
+
+def test_gather_sorts_and_excludes_padding(monkeypatch):
+    monkeypatch.setattr(infer_engine.dist, "get_rank", lambda: 0)
+    monkeypatch.setattr(infer_engine.dist, "get_world_size", lambda: 3)
+
+    def gather(result, output, dst):
+        assert dst == 0
+        output[:] = [({}, {"global_index": 2}), None, ({}, {"global_index": 0})]
+
+    monkeypatch.setattr(infer_engine.dist, "gather_object", gather)
+    assert [item[1]["global_index"] for item in infer_engine.InferEngine.gather_batch_results(None)] == [0, 2]
