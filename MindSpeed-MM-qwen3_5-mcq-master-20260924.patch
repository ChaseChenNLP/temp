+"""Test real runner/data flow while replacing unused model-loading boundaries."""
+
+import importlib
+import json
+import os
+import sys
+from types import ModuleType, SimpleNamespace
+from unittest.mock import Mock, patch
+
+import pytest
+
+os.environ.setdefault("NON_MEGATRON", "true")
+
+
+@pytest.fixture
+def runner_module():
+    # These tests never build a model, initialize a device, or load weights.
+    # Stub only those boundaries so the data-flow tests also run on CPU hosts
+    # without training-only packages such as peft/datasets/fla-npu.
+    boundaries = {
+        "mindspeed_mm.config.config_manager": ["ConfigManager"],
+        "mindspeed_mm.fsdp.checkpoint.dcp_checkpointer": ["DistributedCheckpointer"],
+        "mindspeed_mm.fsdp.checkpoint.hf_checkpointer": ["HuggingFaceCheckpointer"],
+        "mindspeed_mm.fsdp.checkpoint.hf_utils": ["looks_like_hf_weight_dir"],
+        "mindspeed_mm.fsdp.checkpoint.utils": ["retie_embeddings"],
+        "mindspeed_mm.fsdp.distributed.torch_parallelize": ["ParallelApplier"],
+        "mindspeed_mm.fsdp.models.modelhub": ["ModelHub"],
+        "mindspeed_mm.fsdp.utils.utils": ["to_empty_if_needed"],
+    }
+    modules = {}
+    for name, symbols in boundaries.items():
+        module = ModuleType(name)
+        for symbol in symbols:
+            setattr(module, symbol, Mock())
+        modules[name] = module
+    with patch.dict(sys.modules, modules):
+        # Ensure each fixture imports the actual runner with these boundaries.
+        for name in ("mindspeed_mm.fsdp.inference.inference_runner", "mindspeed_mm.fsdp.evaluation.evaluation_runner"):
+            sys.modules.pop(name, None)
+        yield importlib.import_module("mindspeed_mm.fsdp.inference.inference_runner")
+
+
+@pytest.mark.parametrize("rank", [0, 1, 2, 3])
+def test_replicated_dataloader_full_order_on_every_rank(runner_module, monkeypatch, rank):
+    monkeypatch.setattr(runner_module.dist, "get_world_size", lambda: 4)
+    monkeypatch.setattr(runner_module.dist, "get_rank", lambda: rank)
+    samples = [{"sample_id": str(index)} for index in range(5)]
+    loader = runner_module.InferenceRunner.get_dataloader(samples, replicated_inputs=True)
+    assert list(loader) == samples
+
+
+def test_legacy_dataloader_still_partitions_and_pads(runner_module, monkeypatch):
+    monkeypatch.setattr(runner_module.dist, "get_world_size", lambda: 2)
+    samples = [{"sample_id": str(index)} for index in range(3)]
+    for rank, expected in [(0, [samples[0], samples[2]]), (1, [samples[1], samples[0]])]:
+        monkeypatch.setattr(runner_module.dist, "get_rank", lambda: rank)
+        assert list(runner_module.InferenceRunner.get_dataloader(samples)) == expected
+
+
+def test_runner_propagates_replicated_inputs_to_engine(runner_module, monkeypatch):
+    cls = runner_module.InferenceRunner
+    for method in ("initialize", "get_model", "get_adapter"):
+        monkeypatch.setattr(cls, method, lambda self: None)
+    data = [{"sample_id": "0", "text": "test"}]
+    runner = cls(SimpleNamespace(), data_provider=lambda args: data, replicated_inputs=True)
+    assert runner.engine.replicated_inputs is True
+    assert list(runner.engine.inference_dataloader) == data
+
+
+@pytest.mark.parametrize("dataset,replicated", [("mmstar", True), ("realworldqa", True), ("vqa2_val", False)])
+def test_evaluation_selects_replicated_inputs_only_for_new_tasks(
+    runner_module, monkeypatch, tmp_path, dataset, replicated
+):
+    module = importlib.import_module("mindspeed_mm.fsdp.evaluation.evaluation_runner")
+    runner = Mock()
+    monkeypatch.setattr(module, "InferenceRunner", runner)
+    args = SimpleNamespace(
+        evaluation=SimpleNamespace(dataset_type=dataset, result_output_path=str(tmp_path)),
+        inference=SimpleNamespace(adapter="qwen3_5"),
+    )
+    module.EvaluationRunner(args)
+    assert runner.call_args.kwargs["replicated_inputs"] is replicated
+
+
+@pytest.mark.parametrize("rank", [0, 1])
