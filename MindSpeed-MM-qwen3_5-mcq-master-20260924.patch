+"""Deterministic image MCQ scoring; no judge model or VLMEvalKit runtime."""
+
+import json
+import re
+from collections import defaultdict
+from pathlib import Path
+from typing import Any
+
+from .impl_base import BaseEvaluator
+
+
+def extract_choice(prediction: str, choices: dict[str, str]) -> str | None:
+    """Extract an unambiguous final choice, ignoring the reasoning prefix."""
+    answer = prediction.rsplit("</think>", 1)[-1].strip()
+    if not answer or not choices:
+        return None
+    patterns = (
+        r"""(?i)["']answer["']\s*:\s*["']([a-z])["']""",
+        r"(?i:\b(?:(?:the\s+)?(?:correct|final)\s+)?answer\s*(?:is\s*:?|:)\s*" r"(?:option\s+)?)[*_`\s\(\[]*([A-Z])\b",
+        r"\\boxed\{\s*([a-zA-Z])\s*\}",
+    )
+    for pattern in patterns:
+        occurrences = list(re.finditer(pattern, answer))
+        # An explicit prefix does not make 'answer is A or B' unambiguous.
+        for occurrence in occurrences:
+            if re.match(
+                r"""[*_`'"\s\)\]]*(?:or\b|and\b|/)\s*(?:option\s+)?[*_`\s\(\[]*[A-Z]\b""",
+                answer[occurrence.end() :],
+                flags=re.IGNORECASE,
+            ):
+                return None
+        matches = {match.group(1).upper() for match in occurrences}
+        if matches:
+            return next(iter(matches)) if len(matches) == 1 and matches.issubset(choices) else None
+
+    # Do not uppercase prose: the English article 'a' is not an option label.
+    tokens = re.findall(r"\w+", answer)
+    candidates = {token for token in tokens if token in choices}
+    if len(candidates) == 1:
+        choice = next(iter(candidates))
+        if choice in tokens[-5:]:
+            return choice
+    if len(candidates) > 1:
+        return None
+
+    if len(answer) <= 2 * sum(len(text) for text in choices.values()):
+        normalized = answer.casefold()
+        matches = {
+            key
+            for key, text in choices.items()
+            if text.strip() and re.search(r"(?<!\w)" + re.escape(text.strip().casefold()) + r"(?!\w)", normalized)
+        }
+        if len(matches) == 1:
+            return next(iter(matches))
+    return None
+
+
+class VLMEvalMCQEvaluator(BaseEvaluator):
+    def __init__(self, result_output_path: str, model_name: str, dataset_name: str) -> None:
+        self.result_output_path = Path(result_output_path)
+        self.result_prefix = f"{model_name}_{dataset_name}"
+        self.predictions: list[dict[str, Any]] = []
+
+    def update(self, item: dict[str, Any], prediction: str) -> None:
+        choice = extract_choice(prediction, item["choices"])
+        record = {
+            "sample_id": item["sample_id"],
+            "question": item["question"],
+            "choices": item["choices"],
+            "answer": item["answer"],
+            "prediction": prediction,
+            "extracted_choice": choice,
+            "hit": int(choice == item["answer"]),
+        }
+        for key in ("category", "l2_category", "bench"):
+            if key in item:
+                record[key] = item[key]
+        self.predictions.append(record)
+
+    @staticmethod
+    def _accuracy(hits: list[int]) -> float:
+        return round(100 * sum(hits) / len(hits), 2) if hits else 0.0
+
+    def compute(self) -> dict[str, Any]:
+        hits = [record["hit"] for record in self.predictions]
+        metrics = {
+            "overall": self._accuracy(hits),
+            "correct": sum(hits),
+            "total": len(hits),
+            "invalid_predictions": sum(record["extracted_choice"] is None for record in self.predictions),
+        }
+        for key in ("category", "l2_category", "bench"):
+            groups = defaultdict(list)
+            for record in self.predictions:
+                if key in record:
+                    groups[record[key]].append(record["hit"])
+            if groups:
+                metrics[key] = {name: self._accuracy(scores) for name, scores in sorted(groups.items())}
+        return metrics
+
+    def finalize(self) -> dict[str, Any]:
+        metrics = self.compute()
+        self.result_output_path.mkdir(parents=True, exist_ok=True)
+        for suffix, value in (("predictions", self.predictions), ("metrics", metrics)):
+            path = self.result_output_path / f"{self.result_prefix}_{suffix}.json"
+            with path.open("w", encoding="utf-8") as file:
+                json.dump(value, file, ensure_ascii=False, indent=2)
+        return metrics
