diff --git a/examples/qwen3_5/evaluate_qwen3_5_9B.sh b/examples/qwen3_5/evaluate_qwen3_5_9B.sh
new file mode 100755
index 0000000..c2122ec
--- /dev/null
+++ b/examples/qwen3_5/evaluate_qwen3_5_9B.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 1 || ( "$1" != "mmstar" && "$1" != "realworldqa" ) ]]; then
+    echo "Usage: $0 {mmstar|realworldqa}" >&2
+    exit 2
+fi
+dataset="$1"
+script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+cd -- "${script_dir}/../.."
+
+# Override this with the actual CANN installation's set_env.sh when needed.
+CANN_ENV_SCRIPT="${CANN_ENV_SCRIPT:-/usr/local/Ascend/cann/set_env.sh}"
+if [[ ! -r "$CANN_ENV_SCRIPT" ]]; then
+    echo "CANN environment script is not readable: $CANN_ENV_SCRIPT" >&2
+    exit 1
+fi
+# CANN's vendor script may read unset variables; restore strict mode afterwards.
+set +u
+source "$CANN_ENV_SCRIPT"
+set -euo pipefail
+
+export NON_MEGATRON=true
+export MULTI_STREAM_MEMORY_REUSE=2
+export TASK_QUEUE_ENABLE=2
+export ASCEND_LAUNCH_BLOCKING=0
+export ACLNN_CACHE_LIMIT=100000
+export CPU_AFFINITY_CONF=1
+export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
+
+NPUS_PER_NODE="${NPUS_PER_NODE:-8}"
+MASTER_ADDR="${MASTER_ADDR:-localhost}"
+MASTER_PORT="${MASTER_PORT:-6000}"
+NNODES="${NNODES:-1}"
+NODE_RANK="${NODE_RANK:-0}"
+distributed_args=(
+    --nproc_per_node "$NPUS_PER_NODE"
+    --nnodes "$NNODES"
+    --node_rank "$NODE_RANK"
+    --master_addr "$MASTER_ADDR"
+    --master_port "$MASTER_PORT"
+)
+config_path="examples/qwen3_5/qwen3_5_9B_evaluation_${dataset}.yaml"
+timestamp=$(date +%Y%m%d_%H%M%S)
+mkdir -p logs
+torchrun "${distributed_args[@]}" mindspeed_mm/fsdp/evaluation/evaluation_runner.py \
+    "$config_path" 2>&1 | tee "logs/eval_${dataset}_${timestamp}_node${NODE_RANK}.log"
