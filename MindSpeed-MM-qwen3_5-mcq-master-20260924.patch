+"""Validate example configuration and launcher without invoking torchrun."""
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+import yaml
+
+os.environ.setdefault("NON_MEGATRON", "true")
+
+from mindspeed_mm.fsdp.params.evaluation_args import EvaluationArguments
+
+REPO = Path(__file__).resolve().parents[3]
+EXAMPLES = REPO / "examples/qwen3_5"
+
+
+def test_official_configs_match_and_parse(monkeypatch):
+    for key, value in {"LOCAL_RANK": "0", "RANK": "0", "WORLD_SIZE": "8"}.items():
+        monkeypatch.setenv(key, value)
+    common = []
+    for dataset, filename in [("mmstar", "MMStar"), ("realworldqa", "RealWorldQA")]:
+        config = yaml.safe_load((EXAMPLES / f"qwen3_5_9B_evaluation_{dataset}.yaml").read_text())
+        args = EvaluationArguments(**config)
+        assert args.evaluation.dataset_type == dataset
+        assert args.evaluation.dataset_path == f"./data/{filename}.tsv"
+        assert args.evaluation.max_samples is None
+        assert args.parallel.fully_shard_parallel_size == 8
+        assert args.model.model_id == args.inference.adapter == "qwen3_5"
+        assert args.model.gdn_implementation == args.model.causal_conv1d_implementation == "eager"
+        assert args.inference.enable_thinking is True
+        assert args.inference.load == args.model.model_name_or_path == args.inference.processor_path
+        assert args.inference.generation.max_new_tokens == 32768
+        assert args.inference.generation.presence_penalty == 1.5
+        config.pop("evaluation")
+        common.append(config)
+    assert common[0] == common[1]
+
+
+@pytest.mark.parametrize("arguments", [[], ["vqa2_val"], ["MMStar"], ["mmstar", "extra"]])
+def test_invalid_launcher_arguments_exit_two(arguments):
+    result = subprocess.run(
+        ["bash", str(EXAMPLES / "evaluate_qwen3_5_9B.sh"), *arguments], capture_output=True, text=True
+    )
+    assert result.returncode == 2
+    assert "Usage:" in result.stderr
+
+
+@pytest.mark.parametrize("dataset", ["mmstar", "realworldqa"])
+@pytest.mark.parametrize("torchrun_exit", [0, 7])
+def test_launcher_overrides_and_propagates_failure(tmp_path, dataset, torchrun_exit):
+    example_dir = tmp_path / "examples/qwen3_5"
+    example_dir.mkdir(parents=True)
+    launcher = example_dir / "evaluate_qwen3_5_9B.sh"
+    shutil.copy2(EXAMPLES / launcher.name, launcher)
+    binary_dir = tmp_path / "bin"
+    binary_dir.mkdir()
+    fake_torchrun = binary_dir / "torchrun"
+    fake_torchrun.write_text('#!/usr/bin/env bash\nprintf "%s\\n" "$@"\nexit ' + str(torchrun_exit) + "\n")
+    fake_torchrun.chmod(0o755)
+    env = {
+        **os.environ,
+        "PATH": str(binary_dir) + os.pathsep + os.environ["PATH"],
+        "CANN_ENV_SCRIPT": "/dev/null",
+        "NPUS_PER_NODE": "2",
+        "MASTER_ADDR": "test-host",
+        "MASTER_PORT": "6123",
+        "NNODES": "3",
+        "NODE_RANK": "1",
+    }
+    result = subprocess.run(["bash", str(launcher), dataset], cwd=tmp_path, env=env, capture_output=True, text=True)
+    assert result.returncode == torchrun_exit
+    assert result.stdout.splitlines() == [
+        "--nproc_per_node",
+        "2",
+        "--nnodes",
+        "3",
+        "--node_rank",
+        "1",
+        "--master_addr",
+        "test-host",
+        "--master_port",
+        "6123",
+        "mindspeed_mm/fsdp/evaluation/evaluation_runner.py",
+        f"examples/qwen3_5/qwen3_5_9B_evaluation_{dataset}.yaml",
+    ]
+    logs = list((tmp_path / "logs").glob(f"eval_{dataset}_*_node1.log"))
+    assert len(logs) == 1 and logs[0].read_text() == result.stdout
