+"""CPU logic tests; run with NON_MEGATRON=true in the FSDP environment."""
+
+import base64
+import hashlib
+import json
+import os
+from io import BytesIO
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pandas as pd
+import pytest
+from PIL import Image
+
+os.environ.setdefault("NON_MEGATRON", "true")
+
+from mindspeed_mm.fsdp.evaluation.eval_datasets import eval_dataset_dict
+from mindspeed_mm.fsdp.evaluation.eval_datasets.vlmeval_mcq_dataset import VLMEvalMCQDataset
+from mindspeed_mm.fsdp.evaluation.eval_impl import eval_impl_dict
+from mindspeed_mm.fsdp.evaluation.eval_impl.impl_vlmeval_mcq import VLMEvalMCQEvaluator, extract_choice
+
+PNG_BASE64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jRZkAAAAASUVORK5CYII="
+PNG = base64.b64decode(PNG_BASE64)
+CHOICES = {"A": "red", "B": "blue", "C": "green", "D": "yellow"}
+
+
+def make_tsv(tmp_path, rows=None, name="MMStar.tsv"):
+    if rows is None:
+        rows = [{}]
+    records = []
+    for index, row in enumerate(rows):
+        records.append(
+            {"index": str(index), "image": PNG_BASE64, "question": "Which color?", "answer": "B", **CHOICES, **row}
+        )
+    path = tmp_path / name
+    pd.DataFrame(records).to_csv(path, sep="\t", index=False)
+    return path
+
+
+def test_image_reference_prompt_and_content_cache(tmp_path):
+    path = make_tsv(tmp_path, [{}, {"image": "0", "answer": "b", "l2-category": "color"}])
+    data = VLMEvalMCQDataset(path, "MMStar")
+    first, second = list(data)
+    image = Path(first["image"])
+    assert image.read_bytes() == PNG
+    with Image.open(BytesIO(image.read_bytes())) as decoded:
+        decoded.load()
+        assert decoded.size == (1, 1)
+    assert image.name == hashlib.sha256(PNG).hexdigest()[:24] + ".png"
+    assert first["image"] == second["image"]
+    assert second["answer"] == "B" and second["l2_category"] == "color"
+    assert first["sample_id"] == "0"
+    assert first["text"] == (
+        "Question: Which color?\nOptions:\nA. red\nB. blue\nC. green\nD. yellow\n" + VLMEvalMCQDataset.PROMPT_SUFFIX
+    )
+    timestamp = image.stat().st_mtime_ns
+    assert VLMEvalMCQDataset(path, "MMStar")[0]["image"] == str(image)
+    assert image.stat().st_mtime_ns == timestamp
+
+
+def test_reference_beyond_limit_and_multiple_hops(tmp_path):
+    path = make_tsv(tmp_path, [{"image": "1"}, {"image": "2"}, {}])
+    data = VLMEvalMCQDataset(tmp_path, "MMStar", max_samples=1)
+    assert len(data) == 1
+    assert Path(data[0]["image"]).read_bytes() == PNG
+    assert len(VLMEvalMCQDataset(path, "MMStar", max_samples=0)) == 0
+    with pytest.raises(ValueError, match="max_samples"):
+        VLMEvalMCQDataset(path, "MMStar", max_samples=-1)
+
+
+@pytest.mark.parametrize("rows", [[{"image": "1"}, {"image": "0"}], [{"image": "0"}]])
+def test_cyclic_reference(tmp_path, rows):
+    with pytest.raises(ValueError, match="cyclic"):
+        VLMEvalMCQDataset(make_tsv(tmp_path, rows), "MMStar")[0]
+
+
+@pytest.mark.parametrize("column", sorted(VLMEvalMCQDataset.REQUIRED_COLUMNS))
+def test_missing_column(tmp_path, column):
+    path = make_tsv(tmp_path)
+    frame = pd.read_csv(path, sep="\t").drop(columns=[column])
+    frame.to_csv(path, sep="\t", index=False)
+    with pytest.raises(ValueError, match=f"missing required TSV columns: {column}"):
+        VLMEvalMCQDataset(path, "MMStar")
+
+
+def test_duplicate_checked_before_truncation(tmp_path):
+    path = make_tsv(tmp_path, [{}, {"index": "0"}])
+    with pytest.raises(ValueError, match="duplicate sample index"):
+        VLMEvalMCQDataset(path, "MMStar", max_samples=1)
+
+
+@pytest.mark.parametrize(
+    "field,value,message",
+    [
+        ("index", "", "index must not be empty"),
+        ("image", "", "image must not be empty"),
+        ("question", " ", "question must not be empty"),
+        ("answer", "Z", "is not in choices"),
+        ("A", " ", "options A and B"),
+        ("image", "missing.png", "valid base64"),
+        ("image", base64.b64encode(b"not an image").decode(), "Unsupported image"),
+        ("image", "data:image/png,hello", "base64 image data URI"),
+    ],
+)
+def test_invalid_values(tmp_path, field, value, message):
+    with pytest.raises(ValueError, match=message):
+        VLMEvalMCQDataset(make_tsv(tmp_path, [{field: value}]), "MMStar")[0]
+
+
+def test_data_uri_and_paths(tmp_path):
+    image_path = tmp_path / "photo.png"
+    image_path.write_bytes(PNG)
+    path = make_tsv(
+        tmp_path, [{"image": "photo.png"}, {"image": str(image_path)}, {"image": "data:image/png;base64," + PNG_BASE64}]
+    )
+    items = list(VLMEvalMCQDataset(path, "MMStar"))
+    assert items[0]["image"] == items[1]["image"] == str(image_path)
+    assert all(Path(item["image"]).read_bytes() == PNG for item in items)
+
+
+def test_string_ids_literal_na_and_optional_choices(tmp_path):
+    path = make_tsv(tmp_path, [{"index": "001", "A": "NA", "C": "", "D": "", "Z": "last"}])
+    item = VLMEvalMCQDataset(path, "MMStar")[0]
+    assert item["sample_id"] == "001"
+    assert item["choices"] == {"A": "NA", "B": "blue", "Z": "last"}
+
+
+def test_path_precedes_identically_named_reference(tmp_path):
+    (tmp_path / "0").write_bytes(PNG)
+    path = make_tsv(tmp_path, [{"image": "0"}])
+    assert VLMEvalMCQDataset(path, "MMStar")[0]["image"] == str(tmp_path / "0")
+
+
+def test_cache_content_not_sample_id_and_large_base64(tmp_path):
+    path = make_tsv(tmp_path)
+    first = VLMEvalMCQDataset(path, "MMStar")[0]["image"]
+    # Valid magic plus a long payload exercises ENAMETOOLONG on path probing.
+    changed = PNG + b"padding" * 1000
+    make_tsv(tmp_path, [{"image": base64.b64encode(changed).decode()}])
+    second = VLMEvalMCQDataset(path, "MMStar")[0]["image"]
+    assert first != second
+    assert Path(first).read_bytes() == PNG and Path(second).read_bytes() == changed
+
+
+def test_atomic_cache_concurrent_writers_and_repair(tmp_path):
+    path = make_tsv(tmp_path)
+
+    def load_image(_):
+        return Path(VLMEvalMCQDataset(path, "MMStar")[0]["image"])
+
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        images = list(pool.map(load_image, range(16)))
+    assert len(set(images)) == 1
+    assert images[0].read_bytes() == PNG
+    assert list(images[0].parent.iterdir()) == [images[0]]
+    images[0].write_bytes(b"partial")
+    assert load_image(0).read_bytes() == PNG
+
+
+@pytest.mark.parametrize(
+    "header,suffix",
+    [
+        (PNG, ".png"),
+        (b"\xff\xd8\xff\xe0", ".jpg"),
+        (b"GIF89a", ".gif"),
+        (b"GIF87a", ".gif"),
+        (b"RIFF1234WEBP", ".webp"),
+    ],
+)
+def test_image_magic(header, suffix):
+    assert VLMEvalMCQDataset._image_suffix(header) == suffix
+
+
+@pytest.mark.parametrize(
+    "prediction,expected",
+    [
+        ("B", "B"),
+        ("(B).", "B"),
+        ("The correct answer is **C**.", "C"),
+        ("Final answer: option A", "A"),
+        ('{"answer": "B"}', "B"),
+        ("{'answer': 'b'}", "B"),
+        (r"\boxed{D}", "D"),
+        ("<think>A or B</think>C", "C"),
+        ('<think>{"answer": "A"}</think><think>B</think>{"answer": "C"}', "C"),
+        ("blue", "B"),
+        ("The object is green.", "C"),
+        ("A or B", None),
+        ('{"answer":"A", "answer":"B"}', None),
+        ('{"answer":"Z"} blue', None),
+        ("Answer is A. Answer is B.", None),
+        ("blue or green", None),
+        ("Answer is A or B", None),
+        ("The answer is a blue object.", "B"),
+        ("blueberry", None),
+        ("", None),
+        ("I cannot tell.", None),
+        ("B is a possible interpretation but there is no clear conclusion here", None),
+        ("blue " + "reasoning " * 100, None),
+    ],
+)
+def test_extract_choice(prediction, expected):
+    assert extract_choice(prediction, CHOICES) == expected
+
+
+def test_metrics_and_json(tmp_path):
+    evaluator = VLMEvalMCQEvaluator(str(tmp_path / "results"), "qwen3_5", "mmstar")
+    base = {
+        "sample_id": "0",
+        "question": "颜色？",
+        "answer": "B",
+        "choices": CHOICES,
+        "category": "color",
+        "l2_category": "basic",
+    }
+    evaluator.update(base, "B")
+    evaluator.update({**base, "sample_id": "1"}, "A or B")
+    metrics = evaluator.finalize()
+    assert metrics == {
+        "overall": 50.0,
+        "correct": 1,
+        "total": 2,
+        "invalid_predictions": 1,
+        "category": {"color": 50.0},
+        "l2_category": {"basic": 50.0},
+    }
+    records = json.loads((tmp_path / "results/qwen3_5_mmstar_predictions.json").read_text())
+    assert records[1]["prediction"] == "A or B" and records[1]["extracted_choice"] is None
+    assert json.loads((tmp_path / "results/qwen3_5_mmstar_metrics.json").read_text()) == metrics
+    assert evaluator.compute() == metrics
+
+
+def test_wrong_valid_answer_is_not_invalid_and_empty_metrics(tmp_path):
+    evaluator = VLMEvalMCQEvaluator(str(tmp_path), "model", "test")
+    assert evaluator.compute() == {"overall": 0.0, "correct": 0, "total": 0, "invalid_predictions": 0}
+    evaluator.update({"sample_id": "0", "question": "Q", "answer": "B", "choices": CHOICES}, "A")
+    assert evaluator.compute() == {"overall": 0.0, "correct": 0, "total": 1, "invalid_predictions": 0}
+
+
+@pytest.mark.parametrize("key,name", [("mmstar", "MMStar"), ("realworldqa", "RealWorldQA")])
+def test_registration_builder_signature(tmp_path, key, name):
+    make_tsv(tmp_path, name=name + ".tsv")
+    assert len(eval_dataset_dict[key](tmp_path, max_samples=1)) == 1
+    assert eval_impl_dict[key] is VLMEvalMCQEvaluator
+    assert "vqa2_val" in eval_dataset_dict and "vqa2_val" in eval_impl_dict
