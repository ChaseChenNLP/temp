+import os
+
+import pytest
+import torch
+from transformers import LogitsProcessorList
+
+os.environ.setdefault("NON_MEGATRON", "true")
+
+from mindspeed_mm.fsdp.inference.logits_processors import PresencePenaltyLogitsProcessor
+from mindspeed_mm.fsdp.params.inference_args import GenerationArguments
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_presence_penalty_response_only_once_per_token_and_batch(dtype):
+    processor = PresencePenaltyLogitsProcessor(1.5)
+    scores = torch.full((2, 8), 3.0, dtype=dtype)
+    prompt = torch.tensor([[1, 2, 3], [4, 5, 6]])
+    assert processor(prompt, scores) is scores
+    ids = torch.cat((prompt, torch.tensor([[4, 4, 5], [1, 1, 2]])), dim=1)
+    actual = LogitsProcessorList([processor])(ids, scores)
+    expected = scores.clone()
+    expected[0, [4, 5]] -= 1.5
+    expected[1, [1, 2]] -= 1.5
+    torch.testing.assert_close(actual, expected)
+    torch.testing.assert_close(scores, torch.full_like(scores, 3.0))
+
+
+def test_zero_penalty_returns_original_scores():
+    processor = PresencePenaltyLogitsProcessor(0)
+    scores = torch.zeros(1, 10)
+    processor(torch.tensor([[1, 2]]), scores)
+    assert processor(torch.tensor([[1, 2, 3]]), scores) is scores
+
+
+@pytest.mark.parametrize("penalty", [float("inf"), float("-inf"), float("nan")])
+def test_non_finite_penalty_rejected(penalty):
+    with pytest.raises(ValueError, match="finite"):
+        PresencePenaltyLogitsProcessor(penalty)
+
+
+def test_official_generation_kwargs_and_fresh_processor():
+    args = GenerationArguments(
+        max_new_tokens=32768, do_sample=True, temperature=1.0, top_p=0.95, top_k=20, min_p=0.0, presence_penalty=1.5
+    )
+    first = args.to_generate_kwargs(distributed=True)
+    second = args.to_generate_kwargs(distributed=True)
+    assert {key: value for key, value in first.items() if key != "logits_processor"} == {
+        "max_new_tokens": 32768,
+        "do_sample": True,
+        "temperature": 1.0,
+        "top_p": 0.95,
+        "top_k": 20,
+        "min_p": 0.0,
+        "synced_gpus": True,
+        "repetition_penalty": 1.0,
+        "use_cache": True,
+    }
+    assert len(first["logits_processor"]) == 1
+    assert first["logits_processor"][0].penalty == 1.5
+    assert first["logits_processor"][0] is not second["logits_processor"][0]
+    first["logits_processor"][0](torch.tensor([[1, 2]]), torch.zeros(1, 10))
+    assert second["logits_processor"][0].prompt_length is None
+
+
+@pytest.mark.parametrize("penalty", [None, 0.0])
+def test_old_defaults_and_greedy_omit_sampling_kwargs(penalty):
+    kwargs = GenerationArguments(
+        do_sample=False, temperature=1.0, top_p=0.9, top_k=20, min_p=0.1, presence_penalty=penalty
+    ).to_generate_kwargs()
+    assert kwargs == {"max_new_tokens": 512, "do_sample": False, "repetition_penalty": 1.0, "use_cache": True}
+
+
+def test_presence_penalty_also_applies_to_greedy_decoding():
+    assert len(GenerationArguments(presence_penalty=1.5).to_generate_kwargs()["logits_processor"]) == 1

