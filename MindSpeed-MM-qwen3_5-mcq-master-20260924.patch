+"""Response-only logits penalties for Hugging Face generation."""
+
+import math
+
+import torch
+from transformers import LogitsProcessor
+
+
+class PresencePenaltyLogitsProcessor(LogitsProcessor):
+    """Subtract a fixed penalty once per seen response token, not prompt token.
+
+    Create a fresh instance for every generate call: prompt_length is stateful.
+    """
+
+    def __init__(self, penalty: float) -> None:
+        if not math.isfinite(penalty):
+            raise ValueError("presence penalty must be finite")
+        self.penalty = penalty
+        self.prompt_length: int | None = None
+
+    def __call__(self, input_ids: torch.LongTensor, scores: torch.FloatTensor) -> torch.FloatTensor:
+        if self.prompt_length is None:
+            self.prompt_length = input_ids.shape[-1]
+        generated = input_ids[:, self.prompt_length :]
+        if self.penalty == 0 or generated.shape[-1] == 0:
+            return scores
+        seen = torch.zeros_like(scores, dtype=torch.bool)
+        seen.scatter_(dim=1, index=generated, value=True)
+        return scores - seen.to(scores.dtype) * self.penalty
