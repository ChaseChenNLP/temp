+"""VLMEval-compatible image MCQ TSVs, without a VLMEvalKit dependency."""
+
+import base64
+import binascii
+import errno
+import hashlib
+import os
+import string
+import tempfile
+from pathlib import Path
+from typing import Any, Iterator, Optional
+
+import pandas as pd
+
+
+class VLMEvalMCQDataset:
+    REQUIRED_COLUMNS = {"index", "image", "question", "answer", "A", "B"}
+    PROMPT_SUFFIX = (
+        "Please select the correct answer from the options above. "
+        "Please show your choice in the `answer` field with only the choice letter, "
+        'e.g., `"answer": "C"`.'
+    )
+
+    def __init__(
+        self,
+        dataset_path: str | Path,
+        dataset_name: str,
+        max_samples: Optional[int] = None,
+    ) -> None:
+        if max_samples is not None and max_samples < 0:
+            raise ValueError("max_samples must be non-negative or None")
+        if not dataset_name or Path(dataset_name).name != dataset_name or dataset_name in {".", ".."}:
+            raise ValueError("dataset_name must be a single directory name")
+        path = Path(dataset_path).expanduser()
+        self.path = (path / f"{dataset_name}.tsv" if path.is_dir() else path).resolve()
+        # Preserve leading-zero IDs and literal answers such as 'NA'. Only empty
+        # strings are missing; pandas' default NA inference changes MCQ content.
+        frame = pd.read_csv(self.path, sep="\t", dtype=str, keep_default_na=False)
+        missing = self.REQUIRED_COLUMNS - set(frame.columns)
+        if missing:
+            raise ValueError(f"{self.path}: missing required TSV columns: {', '.join(sorted(missing))}")
+        frame["index"] = frame["index"].str.strip()
+        if (frame["index"] == "").any():
+            raise ValueError(f"{self.path}: sample index must not be empty")
+        duplicate = frame.loc[frame["index"].duplicated(), "index"].tolist()
+        if duplicate:
+            raise ValueError(f"{self.path}: duplicate sample index: {duplicate[0]!r}")
+        # References may point outside max_samples. Index the entire input first.
+        self._image_by_id = dict(zip(frame["index"], frame["image"].str.strip()))
+        self._rows = (
+            frame.iloc[:max_samples].to_dict("records") if max_samples is not None else frame.to_dict("records")
+        )
+        self.cache_dir = self.path.parent / ".mindspeed_mm_cache" / dataset_name / "images"
+        self._resolved_images: dict[str, str] = {}
+
+    def __len__(self) -> int:
+        return len(self._rows)
+
+    def __iter__(self) -> Iterator[dict[str, Any]]:
+        for index in range(len(self)):
+            yield self[index]
+
+    def __getitem__(self, index: int) -> dict[str, Any]:
+        row = self._rows[index]
+        sample_id = row["index"]
+        choices = {key: row[key].strip() for key in string.ascii_uppercase if row.get(key, "").strip()}
+        if not {"A", "B"}.issubset(choices):
+            raise ValueError(f"Sample {sample_id}: options A and B must not be empty")
+        answer = row["answer"].strip().upper()
+        if answer not in choices:
+            raise ValueError(f"Sample {sample_id}: answer {answer!r} is not in choices {list(choices)}")
+        question = row["question"].strip()
+        if not question:
+            raise ValueError(f"Sample {sample_id}: question must not be empty")
+        options = "\n".join(f"{key}. {value}" for key, value in choices.items())
+        item = {
+            "sample_id": sample_id,
+            "image": self._resolve_image(row["image"].strip(), sample_id),
+            "text": f"Question: {question}\nOptions:\n{options}\n{self.PROMPT_SUFFIX}",
+            "question": question,
+            "choices": choices,
+            "answer": answer,
+        }
+        for key in ("category", "l2_category", "bench"):
+            value = row.get(key, "").strip()
+            if key == "l2_category" and not value:
+                value = row.get("l2-category", "").strip()
+            if value:
+                item[key] = value
+        return item
+
+    @staticmethod
+    def _image_suffix(header: bytes) -> str:
+        if header.startswith(b"\x89PNG\r\n\x1a\n"):
+            return ".png"
+        if header.startswith(b"\xff\xd8\xff"):
+            return ".jpg"
+        if header.startswith((b"GIF87a", b"GIF89a")):
+            return ".gif"
+        if header.startswith(b"RIFF") and header[8:12] == b"WEBP":
+            return ".webp"
+        raise ValueError("Unsupported image content: expected PNG, JPEG, GIF or WEBP magic bytes")
+
+    def _resolve_image(self, value: str, sample_id: str) -> str:
+        visited: set[str] = set()
+        while True:
+            if not value:
+                raise ValueError(f"Sample {sample_id}: image must not be empty")
+            if value in visited:
+                raise ValueError(f"Sample {sample_id}: cyclic image reference at {value!r}")
+            visited.add(value)
+            if value in self._resolved_images:
+                return self._resolved_images[value]
+            # A real filename takes precedence over an identically named ID.
+            path = Path(value).expanduser()
+            if not path.is_absolute():
+                path = self.path.parent / path
+            try:
+                is_file = path.is_file()
+            except OSError as error:
+                if error.errno != errno.ENAMETOOLONG:
+                    raise
+                is_file = False
+            if is_file:
+                with path.open("rb") as file:
+                    self._image_suffix(file.read(12))
+                resolved = str(path.resolve())
+                break
+            if value in self._image_by_id:
+                value = self._image_by_id[value]
+                continue
+            encoded = value
+            if encoded.startswith("data:image/"):
+                prefix, separator, encoded = encoded.partition(",")
+                if not separator or not prefix.endswith(";base64"):
+                    raise ValueError(f"Sample {sample_id}: expected a base64 image data URI")
+            try:
+                content = base64.b64decode("".join(encoded.split()), validate=True)
+            except (binascii.Error, ValueError) as error:
+                raise ValueError(
+                    f"Sample {sample_id}: image is neither a file, index reference nor valid base64"
+                ) from error
+            suffix = self._image_suffix(content)
+            resolved = str(self._cache_image(content, suffix))
+            break
+        for source in visited:
+            self._resolved_images[source] = resolved
+        return resolved
+
+    def _cache_image(self, content: bytes, suffix: str) -> Path:
+        digest = hashlib.sha256(content).hexdigest()[:24]
+        target = self.cache_dir / f"{digest}{suffix}"
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        if target.is_file() and target.stat().st_size == len(content):
+            return target
+        # Every rank may decode concurrently. Publish only complete files.
+        fd, temporary = tempfile.mkstemp(prefix=f".{digest}-", dir=self.cache_dir)
+        try:
+            with os.fdopen(fd, "wb") as file:
+                file.write(content)
+                file.flush()
+                os.fsync(file.fileno())
+            os.replace(temporary, target)
+        finally:
+            if os.path.exists(temporary):
+                os.unlink(temporary)
+        return target
